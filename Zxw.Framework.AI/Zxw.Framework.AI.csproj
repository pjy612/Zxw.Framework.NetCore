<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Authors>victor.tzeng</Authors>
    <Version>7.0.0</Version>
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>victor.tzeng@outlook.com</Copyright>
    <PackageProjectUrl>https://github.com/VictorTzeng/Zxw.Framework.NetCore</PackageProjectUrl>
    <Description>可选 AI 客户端：内置 OrcaRouter（OpenAI 兼容网关）作为一等 Provider。</Description>
    <PackageReleaseNotes>7.0.0：新增 IChatClient / OrcaRouterChatClient / AddOrcaRouter DI 扩展。</PackageReleaseNotes>
    <PackageTags>AI;LLM;OrcaRouter;OpenAI;Chat</PackageTags>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <MsExtVersion>8.0.0</MsExtVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MsExtVersion>9.0.0</MsExtVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MsExtVersion>10.0.0</MsExtVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MsExtVersion)" />
  </ItemGroup>

</Project>
